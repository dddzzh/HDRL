{
  "generator": {
    "profile": "cai_2025_heft",
    "path": "data",
    "num_workflows": 20,
    "dataset_scale": "small",
    "arrival_process": "cai_2025_exponential",
    "arrival_rate": 0.1
  },
  "resources": {
    "path": "configs/resources_edge_cloud_dvfs_v3.json",
    "num_edge": 84,
    "num_cloud": 27
  },
  "simulation": {
    "ready_task_order": "smallest_workload",
    "deadline_type": "medium",
    "workflow_reliability_requirement": 0.9,
    "default_rho": 1,
    "rho_min": 0.2,
    "energy_eta": 0.5,
    "default_reliability": 0.95,
    "reliability_exponent": 3,
    "enable_backup_duplication": false,
    "remaining_task_reliability_estimate": 0.999,
    "server_history_ema_alpha": 0.9,
    "dvfs_action_floor": "energy_efficient",
    "future_critical_path_safety": true
  },
  "agent": {
    "algorithm": "adapted_dream_dqn",
    "shared": {
      "state": {
        "max_ready_tasks": 32,
        "max_servers": 111
      }
    },
    "dream": {
      "hidden_dim": 128,
      "gamma": 0.3,
      "learning_rate": 0.0003,
      "replay_capacity": 50000,
      "batch_size": 256,
      "epsilon_start": 1,
      "epsilon_min": 0.01,
      "epsilon_decay": 0.9999,
      "target_update_frequency": 50,
      "training_per_episode": 64,
      "training_episodes": 1500,
      "max_grad_norm": 1,
      "huber_delta": 1,
      "max_abs_q": 1000,
      "max_abs_parameter": 1000,
      "enable_fault_tolerance": false,
      "seed": 42,
      "device": "cuda"
    }
  },
  "objective": {
    "reward_mode": "deadline_incremental_only",
    "deadline_violation_weight": 5,
    "fixed_deadline_lambda": 10,
    "fixed_reliability_lambda": 10,
    "high_energy_weight": 1
  },
  "training": {
    "seed": 42,
    "total_episodes": 1500,
    "torch_cpu_threads": 1,
    "eval_interval": 50,
    "eval_episodes": 20,
    "eval_seed": 542000,
    "checkpoint_reliability_target": 1,
    "save_every": 50,
    "save_replay_buffer": false,
    "checkpoint_dir": "results/dream_dqn_sl_111_legacy_train_20wf",
    "eval_seed_secondary": 642000,
    "checkpoint_deadline_esp_threshold": 0.9,
    "checkpoint_deadline_esp_target": 1
  }
}
