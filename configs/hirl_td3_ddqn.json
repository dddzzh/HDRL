{
  "generator": {
    "num_workflows": 20,
    "dataset_scale": "small",
    "arrival_process": "cai_2025_exponential",
    "arrival_rate": 0.1
  },
  "resources": {
    "path": "configs/resources_edge_cloud_dvfs_v3.json",
    "num_edge": 20,
    "num_cloud": 6
  },
  "simulation": {
    "ready_task_order": "smallest_workload",
    "deadline_type": "medium",
    "workflow_reliability_requirement": 0.9,
    "default_rho": 1.0,
    "rho_min": 0.2,
    "enable_backup_duplication": false
  },
  "agent": {
    "algorithm": "adapted_hirl_td3_ddqn",
    "shared": {
      "state": {"max_ready_tasks": 32}
    },
    "hirl": {
      "hidden_dim": 256,
      "gamma": 0.99,
      "ddqn_learning_rate": 0.0001,
      "actor_learning_rate": 0.001,
      "critic_learning_rate": 0.0005,
      "ddqn_replay_size": 600000,
      "td3_replay_size": 5000,
      "batch_size": 256,
      "target_update_frequency": 1000,
      "tau": 0.001,
      "policy_delay": 2,
      "target_noise": 0.2,
      "noise_clip": 0.5,
      "exploration_noise": 0.1,
      "load_noise_alpha": 0.5,
      "load_learning_rate_alpha": 0.5,
      "epsilon_min": 0.01,
      "epsilon_max": 0.3,
      "epsilon_beta": 2.0,
      "priority_alpha": 0.6,
      "priority_beta": 0.4,
      "failure_priority": 1.0,
      "completion_reward": 1.0,
      "energy_weight": 0.5,
      "latency_weight": 0.5,
      "failure_penalty": 1.0,
      "fixed_reliability_lambda": 1.0,
      "min_rho": 0.2,
      "max_rho": 1.0,
      "max_grad_norm": 1.0,
      "seed": 42,
      "device": "auto"
    }
  },
  "training": {
    "seed": 42,
    "total_episodes": 800,
    "save_every": 20,
    "checkpoint_dir": "results/hirl_td3_ddqn",
    "parameter_provenance": {
      "paper_explicit": [
        "total_episodes=800",
        "ddqn_learning_rate=1e-4",
        "actor_learning_rate=1e-3",
        "critic_learning_rate=5e-4",
        "ddqn_replay_size=600000",
        "td3_replay_size=5000",
        "batch_size=256",
        "target_update_frequency=1000",
        "tau=0.001",
        "epsilon_min=0.01",
        "epsilon_max=0.3",
        "load_noise_alpha=0.5",
        "load_learning_rate_alpha=0.5",
        "epsilon_beta=2.0",
        "failure_priority=1.0"
      ],
      "standard_defaults_not_reported_by_paper": [
        "hidden_dim=256",
        "gamma=0.99",
        "policy_delay=2",
        "target_noise=0.2",
        "noise_clip=0.5",
        "exploration_noise=0.1",
        "priority_alpha=0.6",
        "priority_beta=0.4",
        "max_grad_norm=1.0"
      ]
    }
  }
}
