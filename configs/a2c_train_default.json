{
  "experiment_name": "a2c_train",
  "dataset": {
    "type": "alibaba_json",
    "path": "outputs/alibaba_workflows_with_arrivals.json",
    "max_workflows": 50,
    "shuffle": true,
    "deadline_type": "medium",
    "Rreq": 0.9
  },
  "resources": {
    "path": "configs/resources_edge_cloud_default.json",
    "num_edge": 12,
    "num_cloud": 4
  },
  "scheduler": {
    "name": "a2c",
    "params": {
      "training": true,
      "deterministic": false,
      "agent": {
        "gamma": 0.99,
        "entropy_coef": 0.01,
        "value_coef": 0.5,
        "learning_rate": 0.0003,
        "hidden_dim": 128,
        "max_ready_tasks": 32,
        "max_servers": 16,
        "max_rho_levels": 6,
        "device": "cpu"
      }
    }
  },
  "simulation": {
    "default_rho": 1.0,
    "rho_min": 0.5,
    "deadline_type": "medium",
    "default_reliability": 0.9,
    "use_deadline": false,
    "use_reliability": false
  },
  "training": {
    "episodes": 100,
    "save_every": 10,
    "checkpoint_dir": "results/a2c_checkpoints"
  },
  "runs": {
    "seeds": [42],
    "output_root": "results"
  }
}
