{
  "generator": {
    "num_workflows": 20,
    "dataset_scale": "small",
    "arrival_process": "cai_2025_exponential",
    "arrival_rate": 0.1
  },
  "resources": {
    "path": "configs/resources_edge_cloud_dvfs_v3.json",
    "num_edge": 28,
    "num_cloud": 9
  },
  "simulation": {
