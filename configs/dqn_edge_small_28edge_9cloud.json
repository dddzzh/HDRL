    "deadline_violation_weight": 5.0,
    "fixed_deadline_lambda": 10.0,
    "fixed_reliability_lambda": 1.0,
    "high_energy_weight": 3.0
  },
  "training": {
    "seed": 42,
    "total_episodes": 1500,
    "torch_cpu_threads": 1,
    "eval_interval": 50,
    "eval_episodes": 20,
    "eval_seed": 542000,
    "eval_seed_secondary": 642000,
    "checkpoint_deadline_esp_threshold": 0.9,
    "checkpoint_deadline_esp_target": 0.9,
    "checkpoint_reliability_target": 1.0,
    "save_every": 50,
    "checkpoint_dir": "results/dqn_edge_small_28edge_9cloud"
