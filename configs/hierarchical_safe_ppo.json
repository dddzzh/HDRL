{
  "generator": {
    "num_workflows": 10,
    "dataset_scale": "large",
    "arrival_process": "cai_2025_exponential",
    "arrival_rate": 0.05
  },
  "resources": {
    "path": "configs/resources_edge_cloud_default.json",
    "num_edge": 20,
    "num_cloud": 6
  },
  "simulation": {
    "deadline_type": "medium",
    "workflow_reliability_requirement": 0.9,
    "default_rho": 1.0,
    "rho_min": 0.2,
    "energy_eta": 0.5,
    "default_reliability": 0.9,
    "reliability_exponent": 1.0,
    "enable_backup_duplication": true,
    "remaining_task_reliability_estimate": 0.999,
    "server_history_ema_alpha": 0.9,
    "backup_rho_levels": [1.0]
  },
  "agent": {
    "shared": {
      "device": "auto",
      "state": {
        "max_ready_tasks": 32
      }
    },
    "high": {
      "hidden_dim": 256,
      "hidden_layers": 2,
      "primary_embedding_dim": 32,
      "learning_rate": 0.0003,
      "reward_gamma": 0.99,
      "reward_gae_lambda": 0.95,
      "cost_gamma": 1.0,
      "cost_gae_lambda": 1.0,
      "clip_ratio": 0.2,
      "ppo_epochs": 4,
      "batch_size": 256,
      "entropy_coef": 0.005,
      "value_coef": 0.5,
      "cost_value_coef": 0.5,
      "max_grad_norm": 1.0,
      "use_p3o": true,
      "kappa_deadline": 50.0,
      "kappa_reliability": 5.0,
      "epsilon_min": 0.1,
      "epsilon_decay": 0.00005,
      "replay_size": 50000,
      "training_per_episode": 10,
      "deadline_cost_reward_weight": 1.0
    },
    "low": {
      "hidden_dim": 128,
      "hidden_layers": 2,
      "learning_rate": 0.0003,
      "gamma": 0.0,
      "clip_ratio": 0.2,
      "ppo_epochs": 4,
      "batch_size": 128,
      "entropy_coef": 0.01,
      "value_coef": 0.5,
      "cost_value_coef": 0.5,
      "kappa_deadline": 5.0,
      "max_grad_norm": 1.0,
      "beta_concentration_min": 1.0,
      "beta_action_eps": 0.000001
    }
  },
  "objective": {
    "high_makespan_weight": 1.0,
    "high_low_reward_weight": 0
  },
  "training": {
    "seed": 42,
    "training_mode": "joint",
    "total_episodes": 1500,
    "update_mode": "episode_end",
    "eval_interval": 20,
    "eval_episodes": 5,
    "save_every": 20,
    "save_replay_buffer": false,
    "checkpoint_dir": "results/hierarchical_safe_ppo"
  }
}
