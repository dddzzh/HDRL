{
  "generator": {
    "num_workflows": 20,
    "dataset_scale": "small",
    "arrival_process": "cai_2025_exponential",
    "arrival_rate": 0.1
  },
  "resources": {
    "path": "configs/resources_edge_cloud_default.json",
    "num_edge": 20,
    "num_cloud": 6
  },
  "simulation": {
    "ready_task_order": "smallest_workload",
    "deadline_type": "medium",
    "workflow_reliability_requirement": 0.9,
    "default_rho": 1.0,
    "rho_min": 0.2,
    "energy_eta": 0.5,
    "default_reliability": 0.9,
    "reliability_exponent": 1.0,
    "enable_backup_duplication": false,
    "remaining_task_reliability_estimate": 0.999,
    "server_history_ema_alpha": 0.9,
    "sub_deadline": {
      "enabled": true,
      "method": "heft_aft_scaled_v1"
    }
  },
  "agent": {
    "high_algorithm": "d3qn",
    "low_algorithm": "sac",
    "shared": {
      "device": "auto",
      "state": {
        "max_ready_tasks": 32
      }
    },
    "shared_deadline_lagrangian": {
      "enabled": false
    },
    "c3c": {
      "enabled": true,
      "hidden_dim": 128,
      "hidden_layers": 2,
      "learning_rate": 0.0001,
      "gamma": 0.99,
      "tau": 0.005,
      "replay_size": 50000,
      "batch_size": 256,
      "training_per_episode": 5,
      "max_grad_norm": 1.0,
      "deadline_loss_weight": 1.0,
      "harmful_fraction": 0.25,
      "candidate_storage_dtype": "float16",
      "beta_final": 0.25,
      "warmup_transitions": 20000,
      "beta_anneal_transitions": 40000,
      "uncertainty_scale_floor": 0.02,
      "uncertainty_ema_alpha": 0.99,
      "low_guidance_enabled": false,
      "low_guidance_weight_final": 0.0,
      "low_guidance_updates": 0,
      "q_scale_alignment_enabled": true,
      "correction_q_std_clip": 0.5,
      "correction_q_std_floor": 0.001,
      "correction_advantage_std_floor": 0.0001,
      "constraint_gate_enabled": true,
      "constraint_gate_activate_success": 0.97,
      "constraint_gate_deactivate_success": 0.95,
      "constraint_gate_window_workflows": 500,
      "constraint_gate_min_workflows": 500,
      "constraint_gate_anneal_workflows": 1000
    },
    "high": {
      "action_mode": "primary_only",
      "backup_selection": "disabled",
      "hidden_dim": 256,
      "hidden_layers": 2,
      "learning_rate": 0.0003,
      "reward_gamma": 0.99,
      "epsilon_min": 0.1,
      "epsilon_decay": 0.00018,
      "replay_size": 50000,
      "batch_size": 256,
      "training_per_episode": 10,
      "reward": {
        "mode": "scalar",
        "std_floor": 1.0,
        "component_clip": 3.0,
        "lagrangian_energy_normalization": "none"
      },
      "lagrangian": {
        "enabled": true,
        "constraint_metric": "sub_deadline_violation",
        "deadline_budget": 0.0,
        "deadline_lambda_init": 1.0,
        "dual_learning_rate": 0.01,
        "lambda_max": 100.0,
        "warmup_episodes": 50,
        "window_workflows": 100,
        "update_interval": "episode_end"
      }
    },
    "low": {
      "algorithm": "sac",
      "hidden_dim": 128,
      "hidden_layers": 2,
      "learning_rate": 0.0003,
      "gamma": 0.99,
      "tau": 0.005,
      "alpha": 0.2,
      "automatic_entropy_tuning": false,
      "action_dim": 1,
      "log_std_min": -5.0,
      "log_std_max": 2.0,
      "replay_size": 50000,
      "batch_size": 128,
      "training_per_episode": 10,
      "max_grad_norm": 1.0,
      "reward": {
        "mode": "sub_deadline_lagrangian",
        "energy_weight": 1.0,
        "slack_time_weight": 0.0,
        "team_energy_weight": 0.0,
        "slack_floor_ratio": 0.05,
        "component_clip": 3.0,
        "energy_std_floor": 0.05,
        "slack_time_std_floor": 0.005,
        "team_energy_std_floor": 0.01
      },
      "lagrangian": {
        "enabled": true,
        "constraint_metric": "sub_deadline_violation",
        "deadline_budget": 0.0,
        "deadline_lambda_init": 1.0,
        "dual_learning_rate": 0.01,
        "lambda_max": 100.0,
        "warmup_episodes": 50,
        "window_workflows": 100,
        "update_interval": "episode_end"
      }
    }
  },
  "objective": {
    "reward_mode": "lagrangian_deadline",
    "reward_profile": "sub_deadline_lagrangian_v1",
    "deadline_violation_weight": 3.0,
    "high_energy_weight": 1.0,
    "team_energy_weight": 0.0,
    "c3c_reward_profile": "c3c_sub_deadline_residual_v1"
  },
  "training": {
    "seed": 42,
    "torch_cpu_threads": 1,
    "training_mode": "joint",
    "total_episodes": 1500,
    "update_mode": "episode_end",
    "eval_interval": 20,
    "eval_episodes": 20,
    "eval_seed": 242000,
    "save_every": 20,
    "save_replay_buffer": false,
    "checkpoint_deadline_target": 0.99,
    "checkpoint_dir": "results/hierarchical_d3qn_sac_c3c_subdeadline"
  }
}
