  "training": {
    "seed": 42,
    "torch_cpu_threads": 1,
    "training_mode": "joint",
    "total_episodes": 1500,
    "update_mode": "episode_end",
    "eval_interval": 50,
    "eval_episodes": 5,
    "eval_seed": 542000,
    "eval_seed_secondary": 642000,
    "checkpoint_deadline_esp_threshold": 0.90,
    "checkpoint_deadline_esp_target": 0.90,
    "checkpoint_reliability_target": 1.0,
    "save_every": 50,
    "save_replay_buffer": false,
    "checkpoint_dir": "results/oo_actor_critic_medium_28edge_9cloud"
  }
