{
  "generator": {
    "num_workflows": 20,
    "dataset_scale": "middle",
    "arrival_process": "cai_2025_exponential",
    "arrival_rate": 0.1
  },
  "resources": {
    "path": "configs/resources_edge_cloud_dvfs_v3.json",
    "num_edge": 28,
    "num_cloud": 9
  },
  "simulation": {
    "ready_task_order": "smallest_workload",
    "deadline_type": "medium",
    "workflow_reliability_requirement": 0.9,
    "default_rho": 1.0,
    "rho_min": 0.2,
    "energy_eta": 0.5,
    "default_reliability": 0.95,
    "reliability_exponent": 3.0,
    "enable_backup_duplication": false,
    "remaining_task_reliability_estimate": 0.999,
    "server_history_ema_alpha": 0.9,
    "dvfs_action_floor": "energy_efficient"
  },
  "agent": {
    "algorithm": "adapted_oo_actor_critic",
    "shared": {
      "device": "cuda",
      "state": {
        "version": "d3qn_high_deadline_queue_v2",
        "max_ready_tasks": 48,
        "max_servers": 37
      }
    },
    "oo": {
      "hidden_dim": 256,
