      "num_candidates": 100,
      "top_s": 30,
      "bit_flip_probability": 0.2,
      "random_warmup_transitions": 10000,
      "replay_size": 50000,
      "batch_size": 128,
      "training_per_episode": 40,
      "max_grad_norm": 1.0,
      "reward_mode": "hierarchical_fixed_lambda_v2",
      "joint_low_reward_weight": 0.1,
      "low_deadline_violation_weight": 10.0,
      "low_reliability_violation_weight": 10.0,
      "slack_floor_ratio": 0.05,
      "component_clip": 3.0,
      "energy_std_floor": 0.05,
      "slack_time_std_floor": 0.005,
      "deadline_cost_reward_weight": 0.0
